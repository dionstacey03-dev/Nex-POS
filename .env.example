# Runtime application connection: use a dedicated non-owner role without BYPASSRLS.
DATABASE_URL=
# Migration connection: owner/migration role, never used by API functions.
MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set only for an explicitly approved production migration.
ALLOW_PRODUCTION_MIGRATIONS=false

# Optional server-side AI feature.
GEMINI_API_KEY=
