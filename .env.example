DATABASE_URL=
APP_DB_ROLE=
# Migration connection: direct Neon URL using a separate owner/migration role.
MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set only for an explicitly approved production migration.
ALLOW_PRODUCTION_MIGRATIONS=false

# Optional server-side AI feature.
GEMINI_API_KEY=
